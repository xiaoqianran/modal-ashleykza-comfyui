# Copy this file to .env and fill only the keys you actually use.
# .env is ignored by Git and can be injected into Modal automatically.
# Never commit real credentials.

# Hugging Face: required for gated/private repos; optional for public models.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Civitai API token: required for restricted/authenticated Civitai downloads.
CIVITAI_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub fine-grained token: only needed for private custom-node repositories.
# Prefer read-only Contents access scoped to the specific repositories.
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional API keys used by custom nodes such as ComfyUI-OllamaGemini.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
QWEN_API_KEY=

# Optional Ollama endpoint consumed by ComfyUI-OllamaGemini.
OLLAMA_URL=http://localhost:11434
