{
  "schema": 1,
  "id": "cosmos3-super-image2video-4step",
  "title": "Cosmos3-Super-Image2Video-4Step",
  "summary": "64B 图生视频 DMD2 蒸馏 4 步（832×480 / 93 帧 / 16fps）。euler + cfg 1.0 + distilled_4step，无需 CFG。transformer 是 ConvRot int4（约 47GB）+ split_reasoner。测试 L40S，正式 RTX-PRO-6000。不要用 T4。",
  "kind": "i2v",
  "mode": "workflow",
  "workflow": "examples/cosmos3-super-image2video-4step.json",
  "lock": "examples/cosmos3-super-image2video-4step.lock.json",
  "gpu": "L40S",
  "gpu_inference": "RTX-PRO-6000",
  "gpu_choices": [
    "L40S",
    "RTX-PRO-6000"
  ],
  "client_id": "studio-cosmos3-super-i2v-4step",
  "filename_prefix": "video/Cosmos3_super_i2v_4step",
  "io": {
    "images_in": 1
  },
  "params": [
    {
      "id": "image",
      "type": "image",
      "bind": "image",
      "title": "输入图",
      "required": true,
      "help": "首帧。可一次选多张，按张排队。"
    },
    {
      "id": "prompt",
      "type": "text",
      "bind": "prompt",
      "title": "提示词",
      "required": true
    },
    {
      "id": "seed",
      "type": "int",
      "bind": "seed",
      "title": "种子",
      "default": -1,
      "minimum": -1,
      "help": "-1 表示每条提示词随机。绑 RandomNoise。"
    },
    {
      "id": "steps",
      "type": "int",
      "bind": "steps",
      "title": "步数",
      "default": 4,
      "minimum": 4,
      "maximum": 4,
      "help": "蒸馏日程固定 4 步，改了也会被 distilled_4step 忽略。"
    },
    {
      "id": "cfg",
      "type": "float",
      "bind": "cfg",
      "title": "CFG",
      "default": 1.0,
      "minimum": 1.0,
      "maximum": 1.0,
      "step": 0.5,
      "help": "蒸馏模型不要 CFG，必须 1.0。"
    },
    {
      "id": "width",
      "type": "int",
      "bind": "width",
      "title": "宽",
      "default": 832,
      "minimum": 512,
      "maximum": 1280,
      "step": 16
    },
    {
      "id": "height",
      "type": "int",
      "bind": "height",
      "title": "高",
      "default": 480,
      "minimum": 256,
      "maximum": 720,
      "step": 16
    }
  ]
}
