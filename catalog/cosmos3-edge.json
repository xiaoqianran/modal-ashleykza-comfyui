{
  "schema": 1,
  "id": "cosmos3-edge",
  "title": "Cosmos3-Edge",
  "summary": "NVIDIA Cosmos 3 4B 边缘世界模型，文生视频（832×480 / 93 帧 / 24fps）。Nemotron-dense 骨干，ConvRot int4 约 3GB。提示词建议 JSON temporal_caption。测试 L40S，正式 RTX-PRO-6000。不要用 T4。",
  "kind": "t2v",
  "mode": "workflow",
  "workflow": "examples/cosmos3-edge-t2v.json",
  "lock": "examples/cosmos3-edge-t2v.lock.json",
  "gpu": "L40S",
  "gpu_inference": "RTX-PRO-6000",
  "gpu_choices": [
    "L40S",
    "RTX-PRO-6000"
  ],
  "client_id": "studio-cosmos3-edge",
  "filename_prefix": "video/Cosmos3_edge",
  "io": {
    "images_in": 0
  },
  "params": [
    {
      "id": "prompt",
      "type": "text",
      "bind": "prompt",
      "title": "提示词",
      "required": true,
      "help": "Edge 对纯文本不如 Nano/Super 稳。反射场景可写成 {\"temporal_caption\": \"...\"}。"
    },
    {
      "id": "seed",
      "type": "int",
      "bind": "seed",
      "title": "种子",
      "default": -1,
      "minimum": -1,
      "help": "-1 表示每条提示词随机。绑 RandomNoise。"
    },
    {
      "id": "steps",
      "type": "int",
      "bind": "steps",
      "title": "步数",
      "default": 35,
      "minimum": 4,
      "maximum": 80
    },
    {
      "id": "cfg",
      "type": "float",
      "bind": "cfg",
      "title": "CFG",
      "default": 6.0,
      "minimum": 1.0,
      "maximum": 12.0,
      "step": 0.5
    },
    {
      "id": "width",
      "type": "int",
      "bind": "width",
      "title": "宽",
      "default": 832,
      "minimum": 512,
      "maximum": 1280,
      "step": 16
    },
    {
      "id": "height",
      "type": "int",
      "bind": "height",
      "title": "高",
      "default": 480,
      "minimum": 256,
      "maximum": 720,
      "step": 16
    }
  ]
}
