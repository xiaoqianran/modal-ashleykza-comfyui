{
  "schema": 1,
  "id": "krea2-turbo",
  "title": "Krea-2 Turbo",
  "summary": "官方文生图模板（fp8 Turbo，8 步）。约 17GB 显存；默认 RTX-PRO-6000。",
  "kind": "t2i",
  "mode": "workflow",
  "workflow": "examples/krea2-turbo-t2i.json",
  "lock": "examples/krea2-turbo-t2i.lock.json",
  "gpu": "RTX-PRO-6000",
  "gpu_choices": ["RTX-PRO-6000"],
  "client_id": "studio-krea2-turbo",
  "filename_prefix": "Krea2_turbo_studio",
  "io": {"images_in": 0},
  "params": [
    {
      "id": "prompt",
      "type": "text",
      "bind": "prompt",
      "title": "提示词",
      "required": true
    },
    {
      "id": "seed",
      "type": "int",
      "bind": "seed",
      "title": "种子",
      "default": -1,
      "minimum": -1,
      "help": "-1 表示每条提示词随机。"
    },
    {
      "id": "width",
      "type": "int",
      "bind": "width",
      "title": "宽",
      "default": 1024,
      "minimum": 512,
      "maximum": 2048,
      "step": 16
    },
    {
      "id": "height",
      "type": "int",
      "bind": "height",
      "title": "高",
      "default": 1024,
      "minimum": 512,
      "maximum": 2048,
      "step": 16
    },
    {
      "id": "steps",
      "type": "int",
      "bind": "steps",
      "title": "步数",
      "default": 8,
      "minimum": 1,
      "maximum": 52,
      "help": "官方 Turbo 默认 8 步。RAW 才是 52 步，这份模板不是 RAW。"
    }
  ]
}
