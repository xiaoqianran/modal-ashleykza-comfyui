{
  "schema": 1,
  "id": "cosmos3-super-text2image",
  "title": "Cosmos3-Super-Text2Image",
  "summary": "64B 文生图（1024² / 1 帧）。ConvRot 没有 T2I 专用 int4，64B bf16 主机内存约 240GB；本配方用同架构的 Super int4 做 1 帧图，才能在 L40S 跑。测试 L40S，正式 RTX-PRO-6000。不要用 T4。",
  "kind": "t2i",
  "mode": "workflow",
  "workflow": "examples/cosmos3-super-text2image.json",
  "lock": "examples/cosmos3-super-text2image.lock.json",
  "gpu": "L40S",
  "gpu_inference": "RTX-PRO-6000",
  "gpu_choices": [
    "L40S",
    "RTX-PRO-6000"
  ],
  "client_id": "studio-cosmos3-super-t2i",
  "filename_prefix": "Cosmos3_super_t2i",
  "io": {
    "images_in": 0
  },
  "params": [
    {
      "id": "prompt",
      "type": "text",
      "bind": "prompt",
      "title": "提示词",
      "required": true
    },
    {
      "id": "seed",
      "type": "int",
      "bind": "seed",
      "title": "种子",
      "default": -1,
      "minimum": -1,
      "help": "-1 表示每条提示词随机。绑 RandomNoise。"
    },
    {
      "id": "steps",
      "type": "int",
      "bind": "steps",
      "title": "步数",
      "default": 35,
      "minimum": 4,
      "maximum": 80
    },
    {
      "id": "cfg",
      "type": "float",
      "bind": "cfg",
      "title": "CFG",
      "default": 6.0,
      "minimum": 1.0,
      "maximum": 12.0,
      "step": 0.5
    },
    {
      "id": "width",
      "type": "int",
      "bind": "width",
      "title": "宽",
      "default": 1024,
      "minimum": 512,
      "maximum": 1280,
      "step": 16
    },
    {
      "id": "height",
      "type": "int",
      "bind": "height",
      "title": "高",
      "default": 1024,
      "minimum": 512,
      "maximum": 1280,
      "step": 16
    }
  ]
}
